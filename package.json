{
  "name": "@xeolab/vue-spatial-navi",
  "version": "0.1.1",
  "description": "Spatial (arrow-key) navigation for Vue 3",
  "license": "MIT",
  "author": "xeolab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeolab/vue-spatial-navi.git"
  },
  "homepage": "https://github.com/xeolab/vue-spatial-navi#readme",
  "bugs": {
    "url": "https://github.com/xeolab/vue-spatial-navi/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "vue",
    "spatial-navigation",
    "keyboard-navigation",
    "focus"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.11.2"
}
